load"}},"type":"object","required":["payload"],"title":"GenericInvokeRequest"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"QuantumPipelinePayload":{"properties":{"salinity":{"type":"number","maximum":50.0,"minimum":0.0,"title":"Salinity"},"temperature_celsius":{"type":"number","maximum":45.0,"minimum":-5.0,"title":"Temperature Celsius"},"pH":{"type":"number","maximum":14.0,"minimum":0.0,"title":"Ph"},"material_oxidation_potential":{"type":"number","maximum":2.0,"minimum":-2.0,"title":"Material Oxidation Potential"},"dissolved_oxygen_mgl":{"type":"number","maximum":20.0,"minimum":0.0,"title":"Dissolved Oxygen Mgl"},"current_density_mAcm2":{"type":"number","maximum":10.0,"minimum":0.0,"title":"Current Density Macm2"}},"type":"object","required":["salinity","temperature_celsius","pH","material_oxidation_potential","dissolved_oxygen_mgl","current_density_mAcm2"],"title":"QuantumPipelinePayload","example":{"current_density_mAcm2":0.12,"dissolved_oxygen_mgl":6.5,"material_oxidation_potential":0.44,"pH":7.8,"salinity":35.2,"temperature_celsius":18.5}},"SignalPayload":{"properties":{"node_id":{"type":"string","title":"Node Id","description":"Quantum node identifier, non-empty"},"energy_delta":{"type":"number","minimum":0.0,"title":"Energy Delta","description":"Energy delta ≥ 0.0"},"iterations":{"type":"integer","minimum":0.0,"title":"Iterations","description":"Iteration count ≥ 0"},"confidence":{"type":"number","maximum":1.0,"minimum":0.0,"title":"Confidence","description":"Confidence in [0.0, 1.0]"},"variance":{"type":"number","minimum":0.0,"title":"Variance","description":"Variance ≥ 0.0"}},"type":"object","required":["node_id","energy_delta","iterations","confidence","variance"],"title":"SignalPayload","example":{"confidence":0.92,"energy_delta":0.0001,"iterations":120,"node_id":"qnode_01","variance":0.002}},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"},"input":{"title":"Input"},"ctx":{"type":"object","title":"Context"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}}}